;===============================================
; Peregrino.art
;
; Lightning-fast command-line 
; benchmarking tool & library
; for Arturo
;
; MIT License
; (c) 2026 Yanis Zafirópulos
;-----------------------------------------------
; @file src/peregrino.art
;===============================================

; current version (used by the CLI too)
peregrinoVersion: "0.2.0"

import {progressive}

import ./{helpers/stats}
import ./{helpers/strings}
import ./{helpers/styles}!

; thrown when a benchmarked command doesn't
; exit successfully (= with a non-zero code)
commandFailed: to :errorKind "Command failed"

; thrown when a command takes longer than the given `.timeout`
commandTimedOut: to :errorKind "Command timed out"

; thrown when the given `.prepare` command fails
preparationFailed: to :errorKind "Preparation failed"

;---------------------------
; Running in the background
;---------------------------

currentTime: function [][
    ; current time, in milliseconds
    t: now
    (1000 * to :integer t) + t\nanosecond / 1000000
]

runInBackground: function [cmd, bar, limit][
    ; run the command asynchronously, so that we can keep the bar
    ; "alive" meanwhile + stop it, if it takes longer than `limit` ms
    ; (not for measuring anything: we only know if a task is finished
    ; every ~50ms)
    task: execute.async.code cmd
    started: currentTime
    timedOut?: false

    while [and? not? finished? task not? timedOut?][
        pause 20
        bar\increase 0
        unless null? limit ->
            timedOut?: limit < currentTime - started
    ]

    if timedOut? [
        cancel task
        return null
    ]
    return wait task
]

;---------------------------
; Preparation
;---------------------------

prepareRun: function [prep][
    ; run the preparation command (if any) and return its exit code
    if null? prep -> return 0
    return get execute.code prep 'code
]

;---------------------------
; A "bar" that doesn't draw
; anything at all (= `.minimal`)
;---------------------------

define :silentBar [
    init: method [][
        \processing: ""
        \message: ""
        \label: ""
    ]
    increase: method [q][]
    stop: method [][]
]

define :peregrino [
    init: method [commands][
        ; command-line values like `true` or `42`
        ; are not strings, so make sure they are
        \commands: map commands 'cmd -> to :string cmd
        \stats: []
        \final: []
        \ignoreFailure?: not? null? attr 'ignoreFailure
        \warmupRuns: (attr 'warmup) ?? 1
        \timeout: attr 'timeout
        \prepare: attr 'prepare
        unless null? \prepare ->
            \prepare: to :string \prepare
        
        \minimal?: not? null? attr 'minimal
        \ascii?: not? null? attr 'ascii
        \colorless?: not? null? attr 'colorless

        plusMinus: (\ascii?)? -> "+/-" -> "±"
        times: (\ascii?)? -> "x" -> "×"
        \columns: @[
            #[header:"Command"      short:"Command"     format:{|filename| (*)}]
            #[header:"Average"      short:"Avg"         format:{|withUnit row\data\avg|}]
            #[header:"Comparison"   short:"Cmp"         format:{|row\data\ratio|} ++ times ++ " slower"]
            #[header:"Deviation"    short:"Dev"         format:plusMinus ++ " " ++ {|withUnit row\data\dev|}]
            #[header:"Range"        short:"Range"       format:{|withUnit row\data\min| .. |withUnit row\data\max|}]
        ]
        \mdMode?: false

        \T: (\ascii?) ? -> _tbl\ascii -> _tbl\normal
        \E: (\ascii?) ? -> _elements\ascii -> _elements\normal
    ]

    colored: method [col,str][
        (\colorless?) ? -> str -> color col str
    ]

    printInfo: function [][
        print ""
        print [\colored.bold #magenta "   Peregrino" ~"v|peregrinoVersion|"]
        print ""
        print [\colored.bold #gray pad.right "   System :" 10 \colored #gray ~"|sys\cpu\arch|/|sys\os|"]
        print [\colored.bold #gray pad.right "   CPU    :" 10 \colored #gray to :string sys\cpu\cores \colored #gray "cores"]
    ]

    printHeader: method [title][
        print ""
        print \colored #orange repeat \E\horLine terminal\width
        print \colored.bold #orange " " ++ \E\dot ++ " " ++ upper title
        print ""
    ]

    getColumns: method [][
        minNeeded: 0
        minFirstColumn: 25
        columns: new \columns
        loop drop columns 'col [
            col\min: max @[size col\header, max map \final 'row ->
                size ~ col\format
            ]
            minNeeded: minNeeded + col\min + 2
        ]
        ; in Markdown, there is no terminal width to fit in:
        ; just make room for the longest command (+ the outliers mark)
        if \mdMode? -> 
            return \getMarkdownColumns columns

        minNeeded: minNeeded + 
                    2 +  ; spaces front/back
                    6    ; line separators

        spaceLeft: terminal\width - minNeeded
        columns\0\min: spaceLeft - 2

        if columns\0\min < minFirstColumn [
            lastCol: pop 'columns
            columns\0\min: spaceLeft + (lastCol\min + 1)
        ]

        adjust: 2
        do.times: 2 [
            c: 1
            while [and? c < size columns columns\0\min >= minFirstColumn + adjust][
                columns\[c]\min: columns\[c]\min + adjust
                columns\0\min: columns\0\min - adjust
                c: c + 1
            ]
        ]

        return columns
    ]

    getMarkdownColumns: method [columns][
        columns\0\min: 4 + max @[
            size columns\0\header
            max map \final 'row -> size escapeMarkdown row\cmd
        ]
        return columns
    ]

    finalizeData: method [][
        stats: map \stats 'entry [
            ; a run can never take less than 0ms; if it did, it means
            ; that it took less than our calibration measurement (= the
            ; shell spawning overhead)
            extend getStats map entry\runs 'x -> max @[0.0, x] #[cmd: entry\cmd]
        ]
        bestAvg: min map stats 'v -> v\data\avg
        loop stats 'v [
            ; there's no meaningful comparison against 0 (= null)
            v\data\rel: switch zero? bestAvg [
                (zero? v\data\avg)? -> 0.0 -> null
            ][
                100 * (v\data\avg - bestAvg) / bestAvg
            ]
            ; = how many times slower than the fastest one
            v\data\ratio: switch zero? bestAvg [
                (zero? v\data\avg)? -> 1.0 -> null
            ][
                v\data\avg / bestAvg
            ]
        ]

        stats: arrange stats 'stat -> stat\data\avg

        \final: map stats 'v [
            #[
                cmd: v\cmd
                data: #.raw flatten map v\data [kk,vv]->
                    @[kk, (null? vv)? -> "" -> nicefloat vv]
                outliers?: v\outliers?
            ]
        ]
    ]

    exportToJson: method [target][
        cleaned: []
        loop \final 'entry [
            newEntry: new entry
            newEntry\data: #.raw flatten map newEntry\data [k,v][
                @[k, (empty? v)? -> null -> to :floating v] 
            ]
            cleaned: cleaned ++ newEntry
        ]
        targetFile: target
        if empty? extract.extension targetFile ->
            targetFile: targetFile ++ ".json"

        write.json cleaned targetFile
    ]

    exportToCsv: method [target][
        ; same data as the Json export (all times in ms)
        quoted: function [str][
            "\"" ++ (replace str "\"" "\"\"") ++ "\""
        ]
        fields: keys get first \final 'data
        lines: @[join.with:"," ["cmd"] ++ fields ++ ["outliers"]]
        loop \final 'entry [
            lines: lines ++ join.with:"," flatten @[
                quoted entry\cmd
                map fields 'f -> entry\data\[f]
                to :string entry\outliers?
            ]
        ]
        targetFile: target
        if empty? extract.extension targetFile ->
            targetFile: targetFile ++ ".csv"

        write (join.with:"\n" lines) ++ "\n" targetFile
    ]

    exportToMarkdown: method [target][
        oldT: \T
        oldColorless?: \colorless?
        \T: _tbl\markdown
        \colorless?: true
        \mdMode?: true

        tblMd: \getTable

        \T: oldT
        \colorless?: oldColorless?
        \mdMode?: false

        targetFile: target
        if empty? extract.extension targetFile ->
            targetFile: targetFile ++ ".md"

        write tblMd targetFile
    ]

    getTable: method [][
        mdMode?: \mdMode?

        cols: \getColumns
 
        tbl: ""
        unless mdMode? [
            ; top line
            tbl: tbl ++ 
                "  " ++ (spacer cols\0\min + 2) ++
                \T\topLeft ++ 
                (join.with:\T\tTop map drop cols 'c ->
                    repeat \T\horLine c\min + 2) ++
                \T\topRight
            tbl: tbl ++ "\n"
        ]
        
        ; header
        tbl: tbl ++ ((mdMode?)? -> " " ++ \T\verLine ++ " " -> "   ") ++ (join.with:\T\verLine map.with:'i cols 'c [
                (i=0)? -> pad.right c\header c\min + 1
                       -> pad.center c\header c\min + 2
            ]) ++ \T\verLine
        tbl: tbl ++ "\n"

        ; sub-header line
        tbl: tbl ++ " " ++ \T\topLeft ++ (join.with:\T\cross map cols 'c ->
            repeat \T\horLine c\min + 2) ++
            \T\tRight
        tbl: tbl ++ "\n"

        ; content
        loop.with:'rowId \final 'row [
            tbl: tbl ++ " " ++ \T\verLine ++ " " ++ (
                join.with:\T\verLine map.with:'i cols 'c [
                    str: switch i=0 [
                        filename: (mdMode?)? -> escapeMarkdown row\cmd
                                             -> truncateLeft row\cmd c\min - 8
                        (pad.right replace ~ c\format "(*)" "" c\min + 1 - (row\outliers? ? -> 4 -> 0)) ++
                            (row\outliers? ? -> \colored #gray "(*) " -> "")
                    ][
                        case c\header [
                            "Deviation" [
                                \colored #gray pad.center ~ c\format c\min + 2
                            ]
                            "Comparison" [
                                txt: (empty? row\data\ratio)? -> "n/a" -> ~ c\format
                                ("1.00" = row\data\ratio) ?
                                    -> pad.center "--" c\min + 2
                                    -> pad.center txt c\min + 2
                            ]
                            any [
                                pad.center ~ c\format c\min + 2
                            ]
                        ]
                    ]
                    (rowId = 0)? -> \colored #green str
                                 -> str
                ]
            ) ++ \T\verLine
            tbl: tbl ++ "\n"
        ]

        unless mdMode? [
            ; bottom line
            tbl: tbl ++ " " ++ \T\bottomLeft ++ (join.with:\T\tBottom map cols 'c ->
                repeat \T\horLine c\min + 2) ++
                \T\bottomRight
        ]

        return tbl
    ]

    showAnalysis: method [][
        unless \minimal? ->
            \printHeader "analysis"

        \finalizeData

        (\minimal?)?[
            loop \final 'entry [
                print " - " ++ ((entry = first \final)? -> \colored #green entry\cmd -> entry\cmd) ++ (entry\outliers? ? -> \colored #gray " (*)" -> "")
                print "       " ++ "avg: " ++ (withUnit entry\data\avg) ++ (\colored #gray " +/- " ++ withUnit entry\data\dev)
                print "       " ++ "rng: " ++ (withUnit entry\data\min) ++ " .. " ++ withUnit entry\data\max
                print " "
            ]
        ][
            print \getTable
        ]

        if some? \final 'f -> f\outliers? [
            print \colored #gray (\minimal? ? -> " (*)" -> "  (*) ") ++ fillEvenly "Detected statistically-significant outliers! You could try running this test again after lowering your system load, in order to to minimize any interference to the results." 6
        ]

        unless \minimal? ->
            print ""
    ]

    idealMsg: function [msgId, msg][
        if terminal\width < 80 -> return truncateLeft msg terminal\width / 4
        if terminal\width < 120 -> return truncateLeft msg terminal\width / 3
        return truncateLeft msg terminal\width / 2
    ]

    ensurePrepared: method [exitCode][
        unless zero? exitCode ->
            throw.as: preparationFailed \prepare ++ " (exit code: " ++ (to :string exitCode) ++ ")"
    ]

    ensureSuccess: method [cmd, exitCode][
        if \ignoreFailure? -> return null
        unless zero? exitCode ->
            throw.as: commandFailed ~"|cmd| (exit code: |exitCode|)"
    ]

    newBar: function [label, total, persistent?][
        ; no bars at all, in minimal mode
        ; (= just the data, e.g. when piping the output)
        if \minimal? -> return to :silentBar []!

        if \ascii? -> do [.plain]
        if \colorless? -> do [.colorless]
        (persistent?)? -> do [.keep] -> do [.ratioless]
        return progressive\new .label: pad.right label 20 total!
    ]

    calibrate: function [][
        ; measure the overhead of spawning a shell (just once, since it's
        ; the same for all commands), so that we can subtract it from every
        ; single run afterwards
        calvalues: []
        bar: \newBar "Calibrating:" 20 false
        loop 20 'x [
            pause 20
            'calvalues ++ to :floating scalar benchmark.get [
                output: execute ""
            ]
            bar\increase 1
        ]
        ; remove the (final) calibration line
        unless \minimal? ->
            prints "\e[A\r\e[J"

        ; (the median, so that a random hiccup doesn't affect everything)
        return median calvalues
    ]

    warmup: function [cmd, needed?][
        ; run the command (without measuring it), to make sure it works,
        ; let it fill any caches + get an idea of how long it takes
        ; (if we have to figure out the number of runs, we need at least 1)
        warmupRuns: (needed?)? -> max @[1, \warmupRuns] -> \warmupRuns
        if zero? warmupRuns -> return null

        timings: []
        exitCodes: []
        limit: \timeout
        prep: \prepare
        prepCode: 0
        timedOut?: false
        bar: \newBar "Warming up:" warmupRuns false
        loop warmupRuns 'x [
            unless timedOut? [
                if zero? prepCode ->
                    prepCode: prepareRun prep
                'timings ++ to :floating scalar benchmark.get [
                    result: runInBackground cmd bar limit
                ]
                timedOut?: null? result
                unless timedOut? ->
                    'exitCodes ++ result\code
            ]
            ; (not inside the conditional block on purpose: method calls
            ; from there may end up going to a different bar)
            step: (timedOut?)? -> 0 -> 1
            bar\increase step
        ]
        minimal?: \minimal?
        switch timedOut? [
            ; the bar is still "in progress" (= details + bar lines),
            ; so let's clear it + bring the cursor back
            unless minimal? ->
                prints "\r\e[A\e[J"
            cursor true
        ][
            ; remove the (final) warm-up line
            unless minimal? ->
                prints "\e[A\r\e[J"
        ]

        \ensurePrepared prepCode

        ; a command that doesn't finish, cannot be benchmarked
        ; (regardless of `.ignoreFailure`)
        if timedOut? ->
            ; (no string interpolation here: commands may well contain `|`s)
            throw.as: commandTimedOut cmd ++ " (after " ++ (to :string limit) ++ "ms)"

        ; no need to go any further, if the command doesn't even work
        loop exitCodes 'exitCode ->
            \ensureSuccess cmd exitCode

        ; for very quick commands, the time we got from the background task
        ; is not accurate at all, so let's measure one more run - normally
        estimated: average timings
        if estimated < 250 ->
            estimated: to :floating scalar benchmark.get [
                output: execute cmd
            ]

        return estimated
    ]

    calculateRuns: function [timeForOne][
        ; as many runs as fit in ~3 seconds
        ; (commands taking less than 1ms would lead to a division by zero)
        minimumRunningTime: 3000
        calculatedTimes: to :integer minimumRunningTime / max @[1.0, timeForOne]

        return (zero? calculatedTimes)? -> 3 -> calculatedTimes
    ]

    benchmark: method [times][
        unless null? times ->
            if times < 1 -> throw "Number of runs must be at least 1"

        unless \minimal? [
            \printInfo
            \printHeader "benchmarks"
        ]

        calibrator: \calibrate

        loop.with:'commandId \commands 'command [
            
            samples: []
            timeForOne: \warmup command null? times

            ; (commands taking less than 1ms would lead to a division by zero)
            runs: times ?? \calculateRuns timeForOne
            
            bar: \newBar "Benchmarking:" runs true
            bar\processing: \idealMsg commandId command
            bar\increase 0
            exitCode: 0
            prep: \prepare
            prepCode: 0
            loop runs 'x [
                if zero? prepCode ->
                    prepCode: prepareRun prep
                samples: samples ++ (benchmark.get [
                    result: execute.code command
                ])
                unless zero? result\code ->
                    exitCode: result\code
                if x = runs [
                    estimate: nicefloat max @[0.0, (average map samples => scalar) - calibrator]
                    bar\message: \idealMsg commandId command
                    bar\label: (pad.right ~"~ |withUnit estimate|/run" 17) ++ pad.right \E\timer 3
                ]
                bar\increase 1
            ]
            \ensurePrepared prepCode
            \ensureSuccess command exitCode
            ; (one entry per command, even if the same command is given twice)
            \stats: \stats ++ @[#[
                cmd: command
                runs: map samples 'v -> to :floating (scalar v) - calibrator
            ]]
            unless \minimal? ->
                prints "\n"
        ]

        \showAnalysis
    ]
]

peregrino: function [cmds][
    p: to :peregrino [cmds]!
    p\benchmark ø
]