;---------------------------
; Imports
;---------------------------

import ./{peregrino}
import ./{helpers/cmdline}

;---------------------------
; Information
;---------------------------

script: #[
    app:         « peregrino
    version:     peregrinoVersion
    description: « Lightning-fast command-line benchmarking tool & library
    arguments: #[
        command: « One or more commands you want to benchmark
    ]
]

;---------------------------
; Helpers
;---------------------------

renderWithParams: function [template, params][
    ; replace every `|param|` with its value
    ; (we don't use `export` + `render`, since `export` would end up
    ; overwriting any of our own variables with the same name)
    result: template
    loop params [name, value] ->
        result: replace result "|" ++ name ++ "|" to :string value
    result
]

getCommands: function [][
    inputs: optValues
    if optFile [
        inputs: []
        loop optValues 'optV [
            ; (skipping empty lines)
            inputs: inputs ++ select read.lines optV 'line ->
                not? empty? strip line
        ]
    ]
    
    (not? empty? optParams)? [
        d: # to :block optParams
        dicts: map product.cartesian map couple keys d values d 'coup [
            (block? last coup)?[
                map last coup 'item -> @[first coup, item]
            ][
                @[coup]
            ]
        ] 'dic -> dictionary.raw flatten dic

        unique flatten map dicts 'dic [
            map inputs 'val -> 
                renderWithParams val dic
        ]
    ][
        inputs
    ]
]

;---------------------------
; The main entry point
;---------------------------

cmd: to :cmdline #[
    information: script
    options: @[
        @["r" "run"         [:integer] "times"      "Specify number of times to run each command"   ø]
        @["f" "file"        [:logical] ""           "Read commands from text file (one per line)"   false]
        @["p" "params"      [:string]  "string"     "Use custom params in command"                  ""]
        @["w" "warmup"      [:integer] "times"      "Number of warm-up runs, before benchmarking"   1]
        @["t" "timeout"     [:integer] "ms"         "Stop if a warm-up run takes longer than this"  ø]
        @["i" "ignore-failure" [:logical] ""        "Ignore non-zero exit codes"                    false]
        ø
        @["m" "minimal"     [:logical] ""           "No fancy output; just the data!"               false]
        @["a" "ascii"       [:logical] ""           "Use simple style, with ASCII-only characters"  false]
        @["c" "colorless"   [:logical] ""           "Don't use colored output"                      false]
        ø
        @[""  "markdown"    [:string]  "file"       "Export Markdown to given file"                 ""]
        @[""  "json"        [:string]  "file"       "Export Json to given file"                      ""]
    ]
]!
export cmd\processing args

if optAscii -> do [.ascii]
if optColorless -> do [.colorless]
if optMinimal -> do [.minimal]
if optIgnoreFailure -> do [.ignoreFailure]
do @[to :attributeLabel "warmup" optWarmup]
unless null? optTimeout ->
    do @[to :attributeLabel "timeout" optTimeout]

if empty? optValues ->
    cmd\showError "Not enough arguments"

unless null? optRun ->
    if optRun < 1 ->
        cmd\showError "Number of runs must be at least 1"

if optWarmup < 0 ->
    cmd\showError "Number of warm-up runs cannot be negative"

unless null? optTimeout ->
    if optTimeout < 1 ->
        cmd\showError "Timeout must be at least 1ms"

pr: to :peregrino @[getCommands]!

err: try [
    pr\benchmark optRun
]
unless null? err [
    ; not one of ours, so let's not hide it
    if err\kind = commandTimedOut [
        print ""
        print [color #red "!" "Command timed out:" err\message]
        panic.unstyled.code: 1 ""
    ]

    if err\kind <> commandFailed ->
        throw.as: err\kind err\message

    print ""
    print [color #red "!" "Command failed:" err\message]
    print ""
    panic.unstyled.code: 1 "  Use `--ignore-failure` to ignore non-zero exit codes\n"
]

unless empty? optJson ->
    pr\exportToJson optJson

unless empty? optMarkdown ->
    pr\exportToMarkdown optMarkdown